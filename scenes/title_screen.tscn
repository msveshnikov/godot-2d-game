theme_override_font_sizes/font_size = 11
text = "MOVE  ← →     JUMP  SPACE / ↑
Stomp slimes and ride moving platforms.
Collect shiny coins. Do not lick the moon."
horizontal_alignment = 1

[node name="StartButton" type="Button" parent="Center/Card/Buttons"]
