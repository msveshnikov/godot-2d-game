SNACK REALM"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Card/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 13
text = "Six silly worlds. One very large slime."
horizontal_alignment = 1

[node name="Instructions" type="Label" parent="Center/Card/Buttons"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.94, 1, 1)
